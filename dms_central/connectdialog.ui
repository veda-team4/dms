    <string notr="true">

QPushButton {
    background-color: #F7933A; /* 기본 색상 */
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}

/* 마우스를 올렸을 때 (Hover 상태) */
QPushButton:hover {
    background-color: #FF9F50; /* 약간 밝은 오렌지 */
}

/* 버튼을 누르고 있을 때 (Pressed 상태) */
QPushButton:pressed {
    background-color: #D87520; /* 살짝 어두운 오렌지 */
}</string>
