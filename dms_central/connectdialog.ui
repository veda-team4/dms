    border-radius: 4px;
    padding: 4px 8px;
}

/* 드롭다운 리스트 영역 */
QComboBox QAbstractItemView {
    background-color: #1A1A1A;       /* 기본 회색 */
    color: #FFFFFF;
    border: 1px solid #333333;
    padding-left: 2px;
}

QComboBox QAbstractItemView::item {
    height: 30px;
}

QComboBox QAbstractItemView::item:selected {
background-color: #F7933A;
}</string>
